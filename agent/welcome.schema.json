{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NC hub welcome",
  "type": "object",
  "properties": {
    "type": {
      "const": "welcome"
    },
    "session_id": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "server_time": {
      "type": "string",
      "format": "date-time"
    },
    "heartbeat_interval_seconds": {
      "type": "integer",
      "const": 30
    },
    "heartbeat_timeout_seconds": {
      "type": "integer",
      "const": 90
    },
    "policy": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "type",
    "session_id",
    "protocol_version",
    "server_time"
  ],
  "additionalProperties": true
}
