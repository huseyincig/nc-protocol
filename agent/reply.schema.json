{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NC agent job reply",
  "type": "object",
  "properties": {
    "type": {
      "const": "response"
    },
    "job_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "timeout",
        "cancelled"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "result_payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "type",
    "job_id",
    "status"
  ],
  "additionalProperties": true
}
