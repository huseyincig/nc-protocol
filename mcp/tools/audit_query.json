{
  "name": "audit_query",
  "title": "Search Audit Events",
  "description": "Reads the caller tenant audit trail with filters. Read-only introspection over the platform audit chain. Note: tool executions are recorded under action \"tool.execute\" with the tool name in payload.tool — filter by action \"tool.execute\", not by tool name. Empty rows: filter action='tool.execute' with the tool in payload.tool. REQUIRED: 1. set filters 2. page results. IF INVALID_ARGUMENT: tighten filters. DO NOT use log_query; audit chain lives here.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "actor": {
        "type": "string",
        "description": "Filter by actor id/email.",
        "maxLength": 256
      },
      "status": {
        "type": "string",
        "description": "Filter by record status.",
        "maxLength": 32,
        "enum": [
          "success",
          "failure"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50,
        "description": "Maximum events to return."
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Number of events to skip for pagination.",
        "maximum": 2147483647
      },
      "action_filter": {
        "type": "string",
        "description": "Filter by action name (e.g. \"tool.execute\" for tool calls; the tool name itself lives in payload.tool).",
        "maxLength": 128
      }
    },
    "required": []
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "completed on success, failed on error.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "entries": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Audit record id."
            },
            "tenant_id": {
              "type": "string",
              "description": "Owning tenant."
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "description": "Hash-chain sequence number."
            },
            "actor_type": {
              "type": "string",
              "description": "Actor class (user, agent, system, api_key, token)."
            },
            "actor_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Actor id when known."
            },
            "actor_email": {
              "type": [
                "string",
                "null"
              ],
              "description": "Actor email when known."
            },
            "ip_address": {
              "type": [
                "string",
                "null"
              ],
              "description": "Actor IP when known."
            },
            "action": {
              "type": "string",
              "description": "Action name."
            },
            "resource_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Resource class when applicable."
            },
            "resource_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Resource id when applicable."
            },
            "request_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Correlated request id when known."
            },
            "created_at": {
              "type": "string",
              "description": "Record timestamp.",
              "format": "date-time"
            },
            "status": {
              "type": "string",
              "description": "Recorded outcome (success/failure)."
            },
            "entry_hash": {
              "type": "string",
              "description": "Hash-chain entry hash."
            },
            "prev_hash": {
              "type": "string",
              "description": "Previous chain hash."
            },
            "payload": {
              "type": "object",
              "description": "Structured event payload (parsed JSON object)."
            }
          }
        },
        "description": "Audit records returned."
      },
      "total": {
        "type": "integer",
        "description": "Total available; may exceed returned entries."
      },
      "retryable": {
        "type": "boolean",
        "description": "Whether a failed call may succeed on retry."
      },
      "duration_ms": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Host-measured execution time when available, otherwise central dispatch wall time in milliseconds."
      },
      "tool": {
        "type": "string",
        "description": "Echo of the invoked tool name."
      },
      "limit": {
        "type": "integer",
        "description": "Applied page size."
      },
      "offset": {
        "type": "integer",
        "description": "Applied page offset."
      },
      "client_id": {
        "type": [
          "string",
          "null"
        ],
        "description": "Echo of the target host id (null: audit is tenant-scoped, not host-scoped)."
      },
      "execution_state": {
        "type": [
          "string",
          "null"
        ],
        "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public error category for model branching. invalid_argument: Fix the input; do not retry the same call unchanged. authentication: Re-authenticate before retrying. authorization: Insufficient permission; do not retry or attempt to bypass. policy: Rejected by host policy; do not attempt to bypass. Adjust the request or ask an operator. not_found: Resource missing; re-discover the id/path/service/container before retrying. conflict: Conflicting state; re-read the current state, then decide. unsupported: Not supported here; do not retry. Look for an alternative tool or capability. timeout: Timed out; if retryable, wait, then poll with job_get. transient: Transient; retry with backoff if retryable. execution: Execution failure; inspect stdout/stderr/state before retrying. cancelled: Cancelled; do not blindly retry. internal: Internal error; if it reproduces, report it with nc_feedback."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ]
      },
      "warnings": {
        "type": "array",
        "description": "Non-fatal advisory notes. Always present; empty when none.",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "status",
      "tool",
      "client_id",
      "retryable",
      "duration_ms",
      "execution_state",
      "warnings"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "title": "Search Audit Events",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "icons": [
    {
      "src": "https://nodecommand.app/icons/audit_query.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "_meta": {
    "nodecommand.app/execution": {
      "taskSupport": "forbidden"
    }
  }
}
