              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Branch ref to push (action=push). Omit to push the current branch tracking state."
            },
            "force": {
              "type": "boolean",
              "default": false,
              "description": "Explicit opt-in for a non-fast-forward push (action=push, lease-guarded). Defaults to false."
            },
            "switch": {
              "type": "boolean",
              "default": false,
              "description": "Check the new branch out after creating it (action=branch). Defaults to false."
