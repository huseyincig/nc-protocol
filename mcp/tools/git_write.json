        },
        "then": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Repository root (or a directory inside it) on the selected client, under allowed roots."
            },
            "remote": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "default": "origin",
              "description": "Configured remote name for action=push/fetch (never a URL). Defaults to origin."
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Branch ref to push (action=push). Omit to push the current branch tracking state."
            },
            "force": {
              "type": "boolean",
              "default": false,
              "description": "Explicit opt-in for a non-fast-forward push (action=push, lease-guarded). Defaults to false."
            },
            "switch": {
              "type": "boolean",
              "default": false,
              "description": "Check the new branch out after creating it (action=branch). Defaults to false."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "description": "Shallow fetch depth (action=fetch). Omit for a full fetch."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_@.][\\w@./-]{0,127}$",
              "description": "Branch name to create (refuses when it already exists)."
            }
          },
          "required": [
            "path",
            "name"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "fetch"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Repository root (or a directory inside it) on the selected client, under allowed roots."
            },
            "remote": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "default": "origin",
              "description": "Configured remote name for action=push/fetch (never a URL). Defaults to origin."
