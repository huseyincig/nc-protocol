{
  "name": "git_write",
  "title": "Write Git Repository",
  "description": "Change a checkout on client_id: add explicit paths, commit staged changes, push (non-fast-forward needs explicit force), branch, fetch, or clone a url into path. clone retains its administrative gate; all writes respect allowed roots and the protected agent tree. Inspect with nc_git_inspect first when state is uncertain. Never paste credentials on authentication failure. Poll nc_job_get for existing jobs and nc_result_fetch for offloads; do not repeat a push to read progress.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/git_write.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "add",
          "commit",
          "push",
          "branch",
          "fetch",
          "clone"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "add"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Repository root (or a directory inside it) on the selected client, under allowed roots."
            },
            "remote": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "default": "origin",
              "description": "Configured remote name for action=push/fetch (never a URL). Defaults to origin."
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Branch ref to push (action=push). Omit to push the current branch tracking state."
            },
            "force": {
              "type": "boolean",
              "default": false,
              "description": "Explicit opt-in for a non-fast-forward push (action=push, lease-guarded). Defaults to false."
            },
            "switch": {
              "type": "boolean",
              "default": false,
              "description": "Check the new branch out after creating it (action=branch). Defaults to false."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "description": "Shallow fetch depth (action=fetch). Omit for a full fetch."
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "description": "Repo-relative files to stage (the repository root itself is refused; list explicit files).",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          "required": [
            "path",
            "paths"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "commit"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Repository root (or a directory inside it) on the selected client, under allowed roots."
            },
            "remote": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "default": "origin",
              "description": "Configured remote name for action=push/fetch (never a URL). Defaults to origin."
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Branch ref to push (action=push). Omit to push the current branch tracking state."
            },
            "force": {
              "type": "boolean",
              "default": false,
              "description": "Explicit opt-in for a non-fast-forward push (action=push, lease-guarded). Defaults to false."
            },
            "switch": {
              "type": "boolean",
              "default": false,
              "description": "Check the new branch out after creating it (action=branch). Defaults to false."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "description": "Shallow fetch depth (action=fetch). Omit for a full fetch."
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Commit message. The call fails when nothing is staged."
            }
          },
          "required": [
            "path",
            "message"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "push"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "path": {
