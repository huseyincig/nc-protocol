{
  "name": "host_inspect",
  "title": "Host Inspect",
  "description": "Read one client_id: snapshot for system resources, diagnose for health checks, disk for bounded volume/subtree usage, connections for sockets, privileges for OS/helper availability. Read-only; privilege visibility grants no elevation. Use nc_file_browse or nc_log_query to investigate findings. Poll nc_job_get for async checks and nc_result_fetch for offloaded output. Respect host policy; do not substitute shell commands for denied typed reads.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/system_snapshot.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "snapshot",
          "diagnose",
          "disk",
          "connections",
          "privileges"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "snapshot"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "diagnose"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "disk"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Optional path to focus a single filesystem."
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Restrict du-style traversal to N levels; equivalent to --max-depth. Omit for the mount-capacity report only."
            },
            "one_file_system": {
              "type": "boolean",
              "description": "Stay on the mounted filesystem; do not cross mount points. Du-style equivalent of -x."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "connections"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "listen",
                "established",
                "all"
              ],
              "description": "Connection state filter. Defaults to listen."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Optional local port filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Maximum rows returned. Defaults to 100."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "privileges"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "status",
      "tool"
    ],
    "unevaluatedProperties": false,
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Echo of the target host id (null when no host was targeted)."
          },
          "job_id": {
            "type": "string",
            "description": "Server job handle for this execution."
          },
          "resource_uri": {
            "type": "string",
            "description": "Offload pointer for a large result text (nc://jobs/<jobId>/output). Present only when the envelope text was offloaded; fetch the full text with nc_result_fetch.",
            "$ref": "#/$defs/shared_resource_uri_0"
          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte size of the offloaded result text. Present only when the envelope text was offloaded."
          },
          "result": {
            "type": "object",
            "properties": {
              "hostname": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "arch": {
                "type": "string"
              },
              "uptime_seconds": {
                "type": "number"
              },
              "cpus": {
                "type": "integer"
              },
              "total_memory_bytes": {
                "type": "integer"
              },
              "free_memory_bytes": {
                "type": "integer"
              },
              "release": {
                "type": "string",
                "description": "OS release string."
              },
              "loadavg": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "1/5/15-minute load averages (platforms without load average report zeros or omit).",
                "minItems": 3,
                "maxItems": 3
              }
            },
            "description": "Snapshot payload."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Host-measured execution time when available, otherwise central dispatch wall time in milliseconds."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_1"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "result",
          "duration_ms",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
