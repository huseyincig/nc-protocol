{
  "name": "package_manage",
  "title": "Manage Package",
  "description": "Inspect installed packages with action=list on client_id; install/remove converge one exact name using manager. Inspection remains read-scoped; mutations retain administrative, policy and helper requirements. No implicit elevation or shell package-manager bypass. Verify changes with list; on PACKAGE_PRIVILEGE_REQUIRED ask an authorized operator. Poll nc_job_get for the existing operation and nc_result_fetch for offloaded output rather than rerunning it.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/package_manage.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "install",
          "remove",
          "list"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "install"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.:~-]{0,127}$",
              "description": "Exact package name in the native manager.",
              "maxLength": 256
            },
            "manager": {
              "type": "string",
              "enum": [
                "auto",
                "apt",
                "dnf",
                "apk",
                "pacman",
                "zypper",
                "winget",
                "brew"
              ],
              "description": "Package manager to use. Defaults to auto (first available on the host). yum is not accepted - pass dnf on rpm-backed hosts. choco is not accepted - Windows uses winget."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "remove"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.:~-]{0,127}$",
              "description": "Exact package name in the native manager.",
              "maxLength": 256
            },
            "manager": {
              "type": "string",
              "enum": [
                "auto",
                "apt",
                "dnf",
                "apk",
                "pacman",
                "zypper",
                "winget",
                "brew"
              ],
              "description": "Package manager to use. Defaults to auto (first available on the host). yum is not accepted - pass dnf on rpm-backed hosts. choco is not accepted - Windows uses winget."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "list"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {
            "manager": {
              "type": "string",
              "enum": [
                "auto",
                "apt",
                "dnf",
                "apk",
                "pacman",
                "zypper",
                "winget",
                "brew"
              ],
              "description": "Package manager to query. Defaults to auto (first available on the host). yum is not accepted - pass dnf on rpm-backed hosts. choco is not accepted - Windows uses winget."
            },
            "contains": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Optional case-insensitive substring filter on package names."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Maximum packages returned. Defaults to 200."
            }
          }
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "status",
      "tool"
    ],
    "unevaluatedProperties": false,
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Echo of the target host id (null when no host was targeted)."
          },
          "job_id": {
            "type": "string",
            "description": "Server job handle for this execution."
          },
          "resource_uri": {
            "type": "string",
            "description": "Offload pointer for a large result text (nc://jobs/<jobId>/output). Present only when the envelope text was offloaded; fetch the full text with nc_result_fetch.",
            "$ref": "#/$defs/shared_resource_uri_0"
          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte size of the offloaded result text. Present only when the envelope text was offloaded."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Execution time in milliseconds."
          },
          "result": {
            "type": "object",
            "description": "Install outcome (installed/version) or removal outcome (removed).",
            "properties": {
              "platform": {
                "type": "string",
                "description": "linux, darwin or win32."
              },
              "manager": {
                "type": "string",
                "description": "Package manager that ran."
              },
              "name": {
                "type": "string",
                "description": "Requested package name."
              },
              "installed": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "True when the package is present after an install."
              },
              "removed": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "True when a remove call removed the package; false when it was already absent."
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Installed version when the manager reports one."
              }
            }
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_1"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "duration_ms",
          "result",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "package_manage"
      },
