{
  "name": "gui_manage",
  "title": "Gui Manage",
  "description": "Manage an allowlisted desktop application on client_id: launch uses application plus optional target/username; close uses the pid returned by launch on this host in this agent boot. The interactive-session broker owns launch; no shell/start or Session 0 workaround. close cannot touch foreign PIDs. Use nc_browser_manage for automated web interaction and nc_process_manage for managed command processes. Poll nc_job_get for async results; do not relaunch merely to check progress.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/gui_launch.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "launch",
          "close"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "launch"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "application"
          ],
          "properties": {
            "application": {
              "type": "string",
              "enum": [
                "default_browser",
                "edge",
                "chrome",
                "explorer",
                "notepad",
                "code",
                "cursor",
                "terminal"
              ],
              "description": "Application to launch in the user session (allowlisted). One of: default_browser, edge, chrome, explorer, notepad, code, cursor, terminal."
            },
            "target": {
              "type": "string",
              "maxLength": 4096,
              "description": "Optional document, URL, or path opened by the application."
            },
            "username": {
              "type": "string",
              "maxLength": 256,
              "description": "Target interactive username; omit to use the active console session."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "close"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "description": "Process id previously reported by nc_gui_manage action=launch on the same host.",
              "maximum": 2147483647
            }
          },
          "required": [
            "pid"
          ]
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "status",
      "tool"
    ],
    "unevaluatedProperties": false,
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Echo of the target host id (null when no host was targeted)."
          },
          "job_id": {
            "type": "string",
            "description": "Server job handle for this execution."
          },
          "resource_uri": {
            "type": "string",
            "description": "Offload pointer for a large result text (nc://jobs/<jobId>/output). Present only when the envelope text was offloaded; fetch the full text with nc_result_fetch.",
            "$ref": "#/$defs/shared_resource_uri_0"
          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte size of the offloaded result text. Present only when the envelope text was offloaded."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Execution time in milliseconds."
          },
          "result": {
            "type": "object",
            "properties": {
              "application": {
                "type": "string",
                "description": "Launched application."
              },
              "target": {
                "type": "string",
                "description": "Launch target."
              },
              "user": {
                "type": "string",
                "description": "Session user."
              },
              "session_id": {
                "type": "string",
                "description": "Broker session id."
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Operating-system PID (null while unknown)."
              }
            },
            "description": "Agent payload for this execution."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_1"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "result",
          "duration_ms",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "gui_launch"
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Echo of the target host id (null when no host was targeted)."
          },
          "job_id": {
            "type": "string",
            "description": "Server job handle for this execution."
          },
          "resource_uri": {
            "type": "string",
            "description": "Offload pointer for a large result text (nc://jobs/<jobId>/output). Present only when the envelope text was offloaded; fetch the full text with nc_result_fetch.",
            "$ref": "#/$defs/shared_resource_uri_0"
          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
