            ],
            "description": "Execution time in milliseconds."
          },
          "result": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "integer",
                "description": "Closed process id."
              },
              "closed": {
                "type": "boolean",
                "description": "Whether the process was closed by this call."
              }
            },
            "description": "Agent payload for this execution."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_1"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "result",
          "duration_ms",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "gui_close"
      }
    ],
