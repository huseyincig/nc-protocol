                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
