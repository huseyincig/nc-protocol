{
  "name": "file_content",
  "title": "File Content",
  "description": "Read bounded content on client_id: action=read takes path XOR paths (up to 10 files, max_bytes <=65536); extract takes path for DOCX/XLSX/text PDF and max_chars <=65536. Extraction is not OCR; encrypted or unsupported documents fail. Allowed roots and sensitive-path controls apply. Use nc_file_browse to locate files and nc_file_mutate for guarded changes. Poll nc_job_get for existing jobs; retrieve offloaded output with nc_result_fetch.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/file_read.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "read",
          "extract"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "read"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "paths"
              ]
            }
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute path of one file to read. Exactly one of path/paths."
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096
              },
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "description": "Absolute paths to read in one call. Exactly one of path/paths."
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "default": 65536,
              "description": "Maximum bytes to return; larger output is truncated."
            },
            "offset": {
              "type": "integer",
              "description": "Starting UTF-8 byte offset; do not split a character.",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "path"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "paths"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "paths"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "extract"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "properties": {
            "format": {
              "default": "auto",
              "description": "Document format hint. auto detects from file content; an explicit hint still verifies magic bytes and fails loudly on mismatch.",
              "enum": [
                "auto",
                "docx",
                "xlsx",
                "pdf"
              ],
              "type": "string"
            },
            "max_chars": {
              "default": 65536,
              "description": "Maximum extracted characters to return; longer output is truncated with truncated=true.",
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "description": "Absolute path of the document to extract on the selected client.",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
