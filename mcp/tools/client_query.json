          ]
        },
        "then": {
          "required": [
            "error"
          ]
        }
      }
    ]
  },
  "annotations": {
    "title": "Client Query",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "_meta": {
    "nodecommand.app/execution": {
      "taskSupport": "forbidden"
    }
  }
}
