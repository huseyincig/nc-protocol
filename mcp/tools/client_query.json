{
  "name": "client_query",
  "title": "Client Query",
  "description": "Discover authorized hosts with action=list; check one client_id with ping; read up to ten hosts with fleet using label XOR client_ids (85-second window, partial failures). list/fleet need no single client_id. Take real returned IDs, never infer them. This is read-only; use nc_host_inspect for detailed host checks. Poll nc_job_get for an existing job and use nc_result_fetch for offloaded output; do not restart work to read progress.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/client_list.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "list",
          "ping",
          "fleet"
        ]
      }
    },
    "required": [
      "action"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "list"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "all",
                "online",
                "offline"
              ],
              "default": "all",
              "description": "Filter hosts by connectivity state."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100,
              "description": "Maximum hosts to return."
            }
          },
          "required": []
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "ping"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "client_id"
          ],
          "properties": {
            "client_id": {
              "type": "string",
              "pattern": "^nc_[0-9a-f]{64}$",
              "minLength": 67,
              "maxLength": 67,
              "description": "Target NC client. Absolute routing handle, independent of any connection."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "fleet"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "anyOf": [
            {
              "required": [
                "label"
              ]
            },
            {
              "required": [
                "client_ids"
              ]
            }
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "description": "Owner-managed host label to match (case-insensitive). Mutually exclusive with client_ids."
            },
            "client_ids": {
              "type": "array",
              "description": "Explicit host ids (1-10). Mutually exclusive with label.",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^nc_[0-9a-f]{64}$",
                "minLength": 67,
                "maxLength": 67
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "label"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "client_ids"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "client_ids"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "label"
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "status",
      "tool"
    ],
    "unevaluatedProperties": false,
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "clients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "install_mode": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Installation mode of the client."
                },
                "client_id": {
                  "type": "string",
                  "pattern": "^nc_[0-9a-f]{64}$",
                  "description": "Target NC client identity."
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Display name."
                },
                "hostname": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Host machine name."
                },
                "platform": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "OS platform (e.g. linux, win32, darwin)."
                },
                "arch": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "CPU architecture."
                },
                "client_version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Running agent version."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "online",
                    "offline"
                  ],
                  "description": "Current connectivity state."
                },
                "last_seen": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Last contact timestamp.",
                  "format": "date-time"
                },
                "transport": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Live transport name when connected."
                },
                "transport_scheme": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Transport scheme when connected."
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Tool capabilities advertised by the host."
                }
              }
            },
            "description": "Host inventory records."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Host-measured execution time when available, otherwise central dispatch wall time in milliseconds."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null for global inventory calls without a host target."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_0"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "duration_ms",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "client_list"
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "completed on success, failed on error.",
            "enum": [
              "completed",
              "failed"
            ]
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Echo of the target host id (null when no host was targeted)."
          },
          "reachable": {
            "type": "boolean",
            "description": "Whether the host has a live session."
          },
          "online": {
            "type": "boolean",
            "description": "Whether the host is marked online."
          },
          "last_seen_age_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Milliseconds since the host was last seen (null when never seen)."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Host-measured execution time when available, otherwise central dispatch wall time in milliseconds."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_0"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "duration_ms",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "client_ping"
      },
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed when the fan-out ran (per-host outcomes in result), failed on bad selector."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Always null: nc_client_query action=fleet targets a set, not a host."
          },
          "job_id": {
            "type": "string",
            "description": "Server job handle for this execution."
          },
          "resource_uri": {
            "type": "string",
            "description": "Offload pointer for a large result text (nc://jobs/<jobId>/output). Present only when the envelope text was offloaded; fetch the full text with nc_result_fetch."
          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte size of the offloaded result text. Present only when the envelope text was offloaded."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Execution time in milliseconds."
          },
          "result": {
            "type": "object",
            "description": "Per-host snapshots plus summary counts.",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "client_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "completed",
                        "failed"
                      ]
                    },
                    "snapshot": {
                      "type": "object",
                      "description": "Host snapshot on completed items."
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "summary": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer"
                  },
                  "completed": {
                    "type": "integer"
                  },
                  "failed": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_0"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "duration_ms",
          "result",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "fleet_snapshot"
      }
    ],
    "$defs": {
      "shared_error_0": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
