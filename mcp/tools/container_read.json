{
  "name": "container_read",
  "title": "Read Container State",
  "description": "Inspect containers on client_id with action=list or inspect; use logs with container and bounded tail for crash output. Read-only under existing container capabilities and host policy; engine/helper visibility grants no mutation authority. Use nc_compose_op for separately authorized recovery after diagnosis. Poll nc_job_get for existing jobs and nc_result_fetch for offloaded logs. Do not replace a denied typed operation with shell Docker commands.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/container_read.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "list",
          "inspect",
          "logs"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "list"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "inspect"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "container"
          ],
          "properties": {
            "container": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Container name or id prefix to inspect; existing handler-admission grammar rejects option-like names.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{0,255}$"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "logs"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "container"
          ],
          "properties": {
            "container": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Container name or id prefix on the selected client."
            },
            "tail": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "description": "Lines from the end. Defaults to 200."
            }
          }
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "status",
      "tool"
    ],
    "unevaluatedProperties": false,
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Echo of the target host id (null when no host was targeted)."
          },
          "job_id": {
            "type": "string",
            "description": "Server job handle for this execution."
          },
          "resource_uri": {
            "type": "string",
            "description": "Offload pointer for a large result text (nc://jobs/<jobId>/output). Present only when the envelope text was offloaded; fetch the full text with nc_result_fetch.",
            "$ref": "#/$defs/shared_resource_uri_0"
          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte size of the offloaded result text. Present only when the envelope text was offloaded."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Execution time in milliseconds."
          },
          "result": {
            "type": "object",
            "description": "Container inventory (list) or single-container identity (inspect).",
            "properties": {
              "platform": {
                "type": "string",
                "description": "linux, darwin or win32."
              },
              "engine": {
                "type": "string",
                "description": "Engine that answered."
              },
              "truncated": {
                "type": "boolean",
                "description": "True when the row cap cut the listing (list only)."
              },
              "containers": {
                "type": "array",
                "description": "Inventory entries for action=list.",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              },
              "container": {
                "type": "string",
                "description": "Canonical container name for action=inspect."
              },
              "image": {
                "type": "string",
                "description": "Image reference for action=inspect."
              },
              "state": {
                "type": "string",
                "description": "Lifecycle state for action=inspect."
              },
              "running": {
                "type": "boolean",
                "description": "True while the container runs (inspect only)."
              },
              "mounts": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Mount count when the engine reports it."
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Container exit code from inspect state, not the inspection operation exit code.",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "oom_killed": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Engine-reported OOM state, not inferred from logs."
              },
              "restart_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Engine-reported restart count.",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "restart_policy": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Bounded restart policy name only.",
                "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$"
              },
              "compose_working_dir": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Exact Compose project working-directory label only; invalid or absent values are null.",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_1"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "duration_ms",
          "result",
          "execution_state",
          "warnings"
        ],
        "additionalProperties": false,
        "title": "container_read"
