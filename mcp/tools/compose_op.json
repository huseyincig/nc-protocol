{
  "name": "compose_op",
  "title": "Compose Operation",
  "description": "Inspect Compose projects on client_id with action=list; mutate with up/down/restart/pull/stop/start and project_dir under allowed write roots, outside the agent tree. list is read-scoped; mutations retain administrative/policy/helper gates. up is detached; down never removes volumes. Inspect nc_container_read action=logs before recovery. Poll nc_job_get for existing jobs and nc_result_fetch for offloads; never silently elevate or rerun pending effects.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/compose_op.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "up",
          "down",
          "restart",
          "pull",
          "stop",
          "start",
          "list"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "up"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "project_dir"
          ],
          "properties": {
            "project_dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Compose project directory on the selected client, under allowed write roots."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "down"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "project_dir"
          ],
          "properties": {
            "project_dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Compose project directory on the selected client, under allowed write roots."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "restart"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "project_dir"
          ],
          "properties": {
            "project_dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Compose project directory on the selected client, under allowed write roots."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "pull"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "project_dir"
          ],
          "properties": {
            "project_dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Compose project directory on the selected client, under allowed write roots."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "stop"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "project_dir"
          ],
          "properties": {
            "project_dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Compose project directory on the selected client, under allowed write roots."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "start"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "project_dir"
          ],
          "properties": {
            "project_dir": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Compose project directory on the selected client, under allowed write roots."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "list"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [],
          "properties": {}
        }
      }
    ]
  },
