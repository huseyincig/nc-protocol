          },
          "resource_link": {
            "type": "string",
            "description": "Programmatic offload reference (mcp:result_fetch:<jobId>). Present only when the envelope text was offloaded."
          },
          "resource_bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Byte size of the offloaded result text. Present only when the envelope text was offloaded."
          },
          "tool": {
            "type": "string",
            "description": "Echo of the invoked tool name."
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Execution time in milliseconds."
          },
          "result": {
            "type": "object",
            "description": "Mutation receipt fields vary by action.",
            "properties": {
              "path": {
                "type": "string",
                "description": "Written file path."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "create",
                  "replace",
                  "append"
                ],
                "description": "Write mode that was applied."
              },
              "bytes_written": {
                "type": "integer",
                "minimum": 0,
                "description": "Bytes written."
              },
              "previous_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "SHA-256 before the write (null for create)."
              },
              "expected_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Caller-supplied expected hash when given."
              },
              "sha256": {
                "type": "string",
                "description": "SHA-256 after the write."
              },
              "source": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              },
              "overwritten": {
                "type": "boolean"
              },
              "bytes": {
                "type": "integer"
              },
              "changed": {
                "type": "boolean",
                "description": "Whether the edit changed file content."
              },
              "edits_applied": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of edits applied (edit action)."
              },
              "diff": {
                "type": "string",
                "description": "Unified diff of the edit (edit action)."
              },
              "diff_truncated": {
                "type": "boolean",
                "description": "Whether the diff was truncated (edit action)."
              },
              "bytes_before": {
                "type": "integer",
                "minimum": 0,
                "description": "File size before the edit."
              },
              "bytes_after": {
                "type": "integer",
                "minimum": 0,
                "description": "File size after the edit."
              }
            }
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether a failed call may succeed on retry."
          },
          "execution_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Live lifecycle state when the call outlived the sync window (running, queued, ...); null otherwise."
          },
          "error": {
            "type": "object",
            "description": "Structured failure detail. Present when status is failed.",
            "$ref": "#/$defs/shared_error_1"
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal advisory notes. Always present; empty when none.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "tool",
          "client_id",
          "retryable",
          "result",
          "duration_ms",
          "execution_state",
          "warnings"
        ],
