{
  "name": "file_mutate",
  "title": "Mutate File",
  "description": "Modify files on client_id: write requires path/content/mode; edit applies exact guarded text or batch edits; move/copy require source/destination; mkdir creates a directory; delete removes a selected path. Read first with nc_file_content action=read and retain hash guards; ambiguous edits require a fresh read, not removal of guards. Roots and agent-tree protections apply; shell is not a bypass. Cross-host copies use nc_file_transfer. Poll nc_job_get for existing jobs and nc_result_fetch for offloads.",
  "icons": [
    {
      "src": "https://nodecommand.app/icons/file_mutate.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ],
      "theme": "light"
    }
  ],
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "unevaluatedProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Select one operation; only its parameters are accepted.",
        "enum": [
          "write",
          "edit",
          "move",
          "copy",
          "mkdir",
          "delete"
        ]
      },
      "client_id": {
        "type": "string",
        "pattern": "^nc_[0-9a-f]{64}$",
        "minLength": 67,
        "maxLength": 67,
        "description": "Target NC client. Absolute routing handle, independent of any connection.",
        "x-mcp-header": "Client-Id"
      }
    },
    "required": [
      "action",
      "client_id"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "write"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "Hash of the file before mutation. Prevents race conditions."
            },
            "path": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute path of the file to write on the selected client."
            },
            "content": {
              "type": "string",
              "description": "Full UTF-8 text to write.",
              "maxLength": 1048576
            },
            "mode": {
              "type": "string",
              "enum": [
                "create",
                "replace",
                "append"
              ],
              "description": "create fails if the file exists; replace overwrites; append adds to the end."
            },
            "encoding": {
              "type": "string",
              "enum": [
                "utf8"
              ],
              "default": "utf8",
              "description": "Content encoding (utf8 only)."
            },
            "create_parents": {
              "type": "boolean",
              "description": "Explicit false does not create parents; omitted preserves legacy automatic provisioning. Omission is not an injected true and does not add directory_manage authority."
            }
          },
          "required": [
            "path",
            "content",
            "mode"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "edit"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "Hash of the file before mutation. Prevents race conditions."
            },
            "path": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute path of the file to write on the selected client."
            },
            "expected_text": {
              "type": "string",
              "description": "Exact current block; must occur exactly once (single-edit mode only; absent in batch mode).",
              "maxLength": 65536,
              "minLength": 1
            },
            "replacement_text": {
              "type": "string",
              "description": "Replacement block; empty string deletes the matched block (single-edit mode only; absent in batch mode).",
              "maxLength": 65536
            },
            "edits": {
              "type": "array",
              "description": "Batch edits applied atomically in order; any mismatch aborts with no write (batch mode only).",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "old_text",
                  "new_text"
                ],
                "properties": {
                  "old_text": {
                    "type": "string",
                    "description": "Exact current block; must occur exactly once at its application step.",
                    "maxLength": 65536,
                    "minLength": 1
                  },
                  "new_text": {
                    "type": "string",
                    "description": "Replacement block.",
                    "maxLength": 65536
                  }
                }
              }
            },
            "dry_run": {
              "type": "boolean",
              "description": "Validate and report the diff without writing. Defaults to false."
            },
            "expected_mtime": {
              "type": "string",
              "description": "Optional optimistic-concurrency guard: ISO-8601 timestamp or epoch milliseconds (as string); must match the current mtime.",
              "maxLength": 64
            }
          },
          "required": [
            "path"
          ],
          "anyOf": [
            {
              "required": [
                "edits"
              ]
            },
            {
              "required": [
                "expected_text",
                "replacement_text"
              ]
            }
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "move"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "Hash of the file before mutation. Prevents race conditions."
            },
            "source": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute source path (file or symlink leaf) on the selected client."
            },
            "destination": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute destination path on the selected client."
            },
            "overwrite": {
              "type": "boolean",
              "default": false,
              "description": "Replace the destination if it already exists."
            }
          },
          "required": [
            "source",
            "destination"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "copy"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "Hash of the file before mutation. Prevents race conditions."
            },
            "source": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute source path (file or symlink leaf) on the selected client."
            },
            "destination": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute destination path on the selected client."
            },
            "overwrite": {
              "type": "boolean",
              "default": false,
              "description": "Replace the destination if it already exists."
            }
          },
          "required": [
            "source",
            "destination"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "mkdir"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute path of the directory to create on the selected client."
            },
            "parents": {
              "type": "boolean",
              "description": "Create parent directories when true; false is nonrecursive. Omitted preserves legacy true behavior without injecting a default into the request."
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "const": "delete"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096,
              "description": "Absolute path of the file, symlink leaf, or directory to delete on the selected client."
            },
            "recursive": {
              "type": "boolean",
              "default": false,
              "description": "Also delete directory contents; required for a non-empty directory."
            }
          }
        }
      }
    ]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution outcome.",
        "enum": [
          "completed",
          "failed"
        ]
      },
      "tool": {
        "type": "string",
        "description": "Requested public tool name; jobs and audit retain source identity."
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "description": "Structured failure detail. Present when status is failed.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code.",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "invalid_argument",
              "authentication",
              "authorization",
              "policy",
              "not_found",
              "conflict",
              "unsupported",
              "timeout",
              "transient",
              "execution",
              "cancelled",
              "internal"
            ],
            "description": "Public failure category. Follow retryable and suggested_action; never bypass authorization or policy. Poll existing jobs with nc_job_get; inspect output before retrying."
          },
          "message": {
            "type": "string",
            "description": "Human-readable failure summary.",
            "minLength": 1,
            "maxLength": 2048
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying may succeed (mirrors top-level retryable)."
          },
          "suggested_action": {
            "type": "object",
            "additionalProperties": false,
            "description": "Machine-readable recovery hint.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "retry",
                  "wait",
                  "change_input",
                  "reauthorize",
                  "call_tool",
                  "contact_operator",
                  "none"
                ],
                "description": "Recovery action type."
              }
            },
            "required": [
              "type"
            ]
          },
          "details": {
            "type": "object",
            "description": "Curated safe context (never secrets, stacks, or internal paths)."
          }
        },
        "required": [
          "code",
          "category",
          "message",
          "retryable",
          "suggested_action"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": true
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "retry",
                        "wait"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retryable": {
                  "const": false
                }
              },
              "required": [
                "retryable"
              ]
            },
            "then": {
              "properties": {
                "suggested_action": {
                  "properties": {
                    "type": {
                      "enum": [
                        "change_input",
                        "reauthorize",
                        "call_tool",
                        "contact_operator",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "status",
      "tool"
    ],
    "unevaluatedProperties": false,
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "description": "completed on success, failed on error."
          },
          "client_id": {
            "type": [
              "string",
