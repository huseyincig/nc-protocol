                  "minLength": 1,
                  "maxLength": 7,
                  "enum": [
                    "process",
                    "browser",
                    "log"
                  ]
                },
                "handle": {
                  "type": "string",
                  "description": "Existing opaque handle.",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "handle"
              ]
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "context_id",
          "client_id",
          "objective",
          "revision",
          "created_at",
          "updated_at",
          "expires_at",
          "completed_steps",
          "next_step",
          "job_refs",
          "handle_refs"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "error"
          ],
          "properties": {
            "result": {
              "maxProperties": 0
            }
          }
        },
        "else": {
          "properties": {
            "result": {
              "minProperties": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "failed"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "error"
          ]
        }
      }
    ]
  },
  "annotations": {
    "title": "Work Context",
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  },
  "_meta": {
    "nodecommand.app/execution": {
      "taskSupport": "forbidden"
    }
  }
}
