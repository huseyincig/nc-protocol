            "minLength": 1,
            "maxLength": 128,
            "pattern": "^ctx_[A-Za-z0-9_-]+$"
          },
          "client_id": {
            "type": "string",
            "pattern": "^nc_[0-9a-f]{64}$",
            "minLength": 67,
            "maxLength": 67,
            "description": "Target NC client. Absolute routing handle, independent of any connection."
          },
          "objective": {
            "type": "string",
            "description": "Concise objective without secrets or raw output.",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "integer",
            "description": "Monotonic checkpoint revision.",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "created_at": {
            "type": "integer",
            "description": "Unix timestamp in milliseconds.",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updated_at": {
            "type": "integer",
            "description": "Unix timestamp in milliseconds.",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expires_at": {
            "type": "integer",
            "description": "Unix timestamp in milliseconds.",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "project_dir": {
            "type": "string",
            "description": "Optional project location; a hint, not path authority.",
            "minLength": 1,
            "maxLength": 4096
          },
          "completed_steps": {
            "type": "array",
            "description": "Concise completed milestones, not transcripts.",
            "items": {
              "type": "string",
              "description": "Completed milestone.",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 20
          },
          "next_step": {
            "type": "string",
            "description": "Next intended step; resume never executes it.",
            "minLength": 1,
            "maxLength": 512
          },
          "job_refs": {
            "type": "array",
            "description": "Existing visible job identifiers on this client; never job outputs.",
            "items": {
              "type": "string",
              "description": "Existing job identifier.",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 10
          },
          "handle_refs": {
            "type": "array",
